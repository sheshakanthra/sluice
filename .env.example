# SLUICE environment (dev defaults). Copy to .env and adjust: `cp .env.example .env`
# Every variable the Go config reads must appear here (enforced by internal/config tests).
# All secrets below are obviously fake dev values. Never put real secrets in this file.

# --- Process ---
# dev | test | rush | demo
APP_ENV=dev
# debug | info | warn | error
LOG_LEVEL=info
HTTP_ADDR=:8080
WORKER_HTTP_ADDR=:9091
MOCKPAY_HTTP_ADDR=:8090
# e.g. 127.0.0.1:6060; empty disables pprof. Never expose publicly.
PPROF_ADDR=

# --- Datastores ---
DATABASE_URL=postgres://sluice:sluice@localhost:5433/sluice?sslmode=disable
MOCKPAY_DATABASE_URL=postgres://sluice:sluice@localhost:5433/mockpay?sslmode=disable
DB_MAX_CONNS=24
REDIS_URL=redis://localhost:6381/0

# --- Auth ---
# kid:base64(32+ bytes),...  The first key signs; all keys verify.
# The value below is base64("sluice-dev-only-not-a-secret-32b"). It is refused when APP_ENV=demo.
TOKEN_KEYS=dev1:c2x1aWNlLWRldi1vbmx5LW5vdC1hLXNlY3JldC0zMmI=
ADMIN_TOKEN=dev-admin-token-change-me
CORS_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=127.0.0.1/32,172.16.0.0/12
RATE_LIMITS_ENABLED=true

# --- Holds / queue ---
HOLD_TTL=5m
PAYMENT_HOLD_TTL=10m
ADMISSION_TTL=10m
# Sliding idle lease: renewed by every request with the admission token; ADMISSION_TTL is the hard cap
ADMISSION_IDLE_TTL=2m
OFFER_CLAIM_TTL=60s
QUEUE_TICK=100ms
QUEUE_MAX_ACTIVE=1000
QUEUE_OVERADMIT=1.5
QUEUE_MIN_ADMIT=10
QUEUE_MAX_ADMIT_PER_TICK=200
# false only allowed when APP_ENV is rush or test
QUEUE_ENFORCED=true
# redis_pg | pg_only
HOLD_PATH=redis_pg
# off | holds_only | naive  (non-off only when APP_ENV is rush or test)
BASELINE=off
MAX_SEATS_PER_ORDER=4
SWEEPER_INTERVAL=1s
RECONCILE_INTERVAL=30s

# --- MockPay (PSP simulator) ---
MOCKPAY_URL=http://localhost:8090
MOCKPAY_PUBLIC_URL=http://localhost:8090
MOCKPAY_API_KEY=dev-mockpay-key
# PSP client connection pool bound per API/worker process (psp_conn_wait_seconds shows queueing)
PSP_MAX_CONNS=64
MOCKPAY_WEBHOOK_SECRET=dev-webhook-secret
PUBLIC_WEBHOOK_URL=http://localhost:8080/api/v1/webhooks/mockpay
# Where the hosted checkout sends the browser back (<PUBLIC_APP_URL>/order?o=<order_id>)
PUBLIC_APP_URL=http://localhost:3000
# uniform min-max per call
MOCKPAY_LATENCY_MS=20-60
MOCKPAY_FAIL_RATE=0
MOCKPAY_TIMEOUT_AFTER_COMMIT_RATE=0
MOCKPAY_HANG_MS=3000
MOCKPAY_WEBHOOK_DUP_RATE=0
MOCKPAY_WEBHOOK_REORDER_RATE=0
MOCKPAY_WEBHOOK_MAX_DELAY_MS=0

# --- Modes ---
DEMO_MODE=false
# true only allowed when APP_ENV is rush or test
TEST_ENDPOINTS_ENABLED=false

# --- Web (read by Next.js in dev only; production builds use same-origin /api) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
