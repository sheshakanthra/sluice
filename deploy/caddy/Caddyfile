# SLUICE front door (:8000): /api/* -> api1..3, /pay/* -> mockpay, else the static web app.
{
	admin off
	# HTTP metrics for Prometheus, served on :9180 (in-network only).
	metrics
	servers {
		# The swarm (and any peer on the compose network) sends a synthetic
		# X-Forwarded-For; Caddy keeps it and appends the peer, so the API's
		# right-most-untrusted rule sees the synthetic client IP.
		trusted_proxies static private_ranges
	}
}

:8000 {
	# Security headers (P7 hygiene). No HSTS: :8000 is plain HTTP; TLS and
	# HSTS belong to whatever terminates TLS in front (DEPLOY.md).
	# Next's static export inlines its bootstrap scripts, hence 'unsafe-inline'.
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# Body cap at the edge, matching the API's 64 KiB (API.md §1).
	request_body {
		max_size 64KB
	}

	handle /api/* {
		reverse_proxy api1:8080 api2:8080 api3:8080 {
			lb_policy least_conn
			# A dial failure (replica killed, C2) is retried on another
			# replica for up to 1 s instead of answering 502.
			lb_try_duration 1s
			lb_try_interval 100ms
			# Active health check: a replica that fails /readyz gets no traffic.
			# /readyz is served from a cached state and dedicated health pools
			# (ADR 0013), so a busy replica stays in rotation and sheds load
			# itself with 503 OVERLOADED instead of being ejected.
			health_uri /readyz
			health_interval 3s
			health_status 2xx
			# Slow probes on a CPU-starved box must not eject a replica. The
			# H 50k CI run (P8-h50k-diagnosis) saw every replica's probe miss a
			# 2 s timeout at T0 and all three ejected for ~6 s (24,632 "no
			# upstreams available"). Now: 5 s per probe, and 5 consecutive
			# failures (about 15 s) mark a replica down; 1 pass brings it back.
			# A killed replica is caught sooner by the passive check below.
			health_timeout 5s
			health_fails 5
			health_passes 1
			# Passive: 100 failed dials within 5 s mark a replica down for
			# the rest of that window. A killed replica (C2) reaches that in
			# well under a second at rush rates; the old default (1 failure)
			# let a single Docker-DNS or connect timeout on a CPU-starved
			# laptop eject a healthy replica (P7a, ADR 0013).
			fail_duration 5s
			max_fails 100
			transport http {
				keepalive 2m
				keepalive_idle_conns_per_host 1024
			}
		}
	}

	# Last resort when every replica looks unhealthy (ADR 0013 addendum):
	# the proxy above answers its own 503 "no upstreams available" only
	# after lb_try_duration found no healthy replica. Rather than turn a
	# starved-but-alive fleet into 503s, send the request to the replicas
	# anyway, ignoring health (a "panic mode"). A replica's own answers,
	# including 503 OVERLOADED, are responses, not errors, so they never
	# land here. If the replicas are really gone, the dials fail and the
	# client gets 502/503 after about 1 s more. X-Upstream-Fallback marks
	# these answers so a run can count them.
	handle_errors 503 {
		@api path /api/*
		handle @api {
			header X-Upstream-Fallback all-unhealthy
			reverse_proxy api1:8080 api2:8080 api3:8080 {
				lb_policy least_conn
				lb_try_duration 1s
				lb_try_interval 100ms
				transport http {
					keepalive 2m
					keepalive_idle_conns_per_host 1024
				}
			}
		}
	}

	# MockPay's /metrics is for Prometheus on the compose network only; the
	# front door (and so the live-demo tunnel) must not serve it (ADR 0016).
	handle /pay/metrics* {
		respond 404
	}

	handle_path /pay/* {
		reverse_proxy mockpay:8090
	}

	handle {
		root * /srv
		try_files {path} {path}.html {path}/index.html /index.html
		file_server
	}
}

# Prometheus scrape target (compose network only; not published).
:9180 {
	metrics /metrics
}
